@model OrdemGo.ViewModels.OrdensServicoIndexViewModel
@{
    ViewData["Title"] = "Ordens de serviço";
}

<div class="ordens-page">
    @if (TempData["MensagemSucesso"] is string mensagemSucesso)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @mensagemSucesso
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }
    @if (TempData["MensagemErro"] is string mensagemErro)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @mensagemErro
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    <div class="ordens-page-header">
        <div>
            <h1>Ordens de serviço</h1>
            <p>Consulte e gerencie as ordens de serviço cadastradas.</p>
        </div>

        <button type="button"
                class="btn btn-primary ordens-add-button"
                data-bs-toggle="modal"
                data-bs-target="#modalCadastroOrdem">
            <span aria-hidden="true">+</span>
            Nova ordem
        </button>
    </div>

    <section class="ordens-card" aria-labelledby="tituloTabelaOrdens">
        <div class="ordens-card-header">
            <div>
                <h2 id="tituloTabelaOrdens">Ordens cadastradas</h2>
                <p id="contadorOrdens" aria-live="polite">@(Model.Ordens.Count == 1 ? "1 ordem encontrada" : $"{Model.Ordens.Count} ordens encontradas")</p>
            </div>
        </div>

        @if (Model.Ordens.Count > 0)
        {
            <div class="ordens-filters" role="search" aria-label="Pesquisar e filtrar ordens de serviço">
                <div class="ordens-search-field">
                    <svg aria-hidden="true" viewBox="0 0 24 24">
                        <circle cx="11" cy="11" r="7"></circle>
                        <path d="m20 20-4-4"></path>
                    </svg>
                    <label class="visually-hidden" for="pesquisaOrdens">Pesquisar ordens</label>
                    <input type="search"
                           id="pesquisaOrdens"
                           class="form-control"
                           placeholder="Pesquisar por número, cliente ou serviço"
                           autocomplete="off" />
                </div>

                <div class="ordens-filter-field">
                    <label class="visually-hidden" for="filtroStatusOrdens">Filtrar por status</label>
                    <select id="filtroStatusOrdens" class="form-select" aria-label="Filtrar ordens por status">
                        <option value="">Todos os status</option>
                        <option value="Aberta">Aberta</option>
                        <option value="Em andamento">Em andamento</option>
                        <option value="Aguardando peças">Aguardando peças</option>
                        <option value="Concluída">Concluída</option>
                        <option value="Cancelada">Cancelada</option>
                    </select>
                </div>

                <div class="ordens-filter-field">
                    <label class="visually-hidden" for="filtroPrioridadeOrdens">Filtrar por prioridade</label>
                    <select id="filtroPrioridadeOrdens" class="form-select" aria-label="Filtrar ordens por prioridade">
                        <option value="">Todas as prioridades</option>
                        <option value="Baixa">Baixa</option>
                        <option value="Normal">Normal</option>
                        <option value="Alta">Alta</option>
                        <option value="Urgente">Urgente</option>
                    </select>
                </div>

                <button type="button" id="limparFiltrosOrdens" class="btn ordens-clear-filters d-none">
                    Limpar filtros
                </button>
            </div>
        }

        <div class="table-responsive">
            <table class="table ordens-table align-middle">
                <thead>
                    <tr>
                        <th scope="col">Número</th>
                        <th scope="col">Cliente</th>
                        <th scope="col">Serviço</th>
                        <th scope="col">Abertura</th>
                        <th scope="col">Prioridade</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="text-end"><span class="visually-hidden">Ações</span></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Ordens.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="ordens-empty-state">
                                <strong>Nenhuma ordem de serviço cadastrada</strong>
                                <span>Crie a primeira ordem para começar.</span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var ordem in Model.Ordens)
                        {
                            var statusVariant = ordem.Status.Trim().ToLowerInvariant() switch
                            {
                                "em andamento" => "progress",
                                "aguardando peças" or "aguardando pecas" => "waiting",
                                "concluída" or "concluida" => "success",
                                "cancelada" => "neutral",
                                _ => "open"
                            };
                            var prioridadeClass = ordem.Prioridade.ToLowerInvariant() switch
                            {
                                "alta" or "urgente" => "ordens-priority-high",
                                "baixa" => "ordens-priority-low",
                                _ => "ordens-priority-normal"
                            };

                            <tr class="ordens-row ordens-row-@statusVariant"
                                data-pesquisa="@ordem.NumeroOS @ordem.Cliente.Nome @ordem.Equipamento @ordem.Modelo"
                                data-status="@ordem.Status"
                                data-prioridade="@ordem.Prioridade">
                                <td><span class="ordens-number">@ordem.NumeroOS</span></td>
                                <td>
                                    <div class="ordens-client-cell">
                                        <span class="ordens-client-avatar" aria-hidden="true">@ordem.Cliente.Nome[..1].ToUpperInvariant()</span>
                                        <span>@ordem.Cliente.Nome</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="ordens-service-cell">
                                        <strong>@ordem.Equipamento</strong>
                                        <span>@ordem.Modelo</span>
                                    </div>
                                </td>
                                <td>@ordem.DataAbertura.ToString("dd/MM/yyyy HH:mm")</td>
                                <td><span class="ordens-priority @prioridadeClass">@ordem.Prioridade</span></td>
                                <td><span class="ordens-status ordens-status-@statusVariant">@ordem.Status</span></td>
                                <td class="text-end">
                                    <div class="dropdown">
                                        <button class="clientes-actions-button"
                                                type="button"
                                                data-bs-toggle="dropdown"
                                                aria-expanded="false"
                                                aria-label="Ações da ordem @ordem.NumeroOS">
                                            &#8942;
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <button type="button"
                                                        class="dropdown-item js-ver-ordem"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#modalOrdem"
                                                        data-ordem-id="@ordem.Id"
                                                        data-ordem-numero="@ordem.NumeroOS"
                                                        data-ordem-cliente="@ordem.Cliente.Nome"
                                                        data-ordem-cliente-id="@ordem.ClienteId"
                                                        data-ordem-responsavel-id="@ordem.ResponsavelId"
                                                        data-ordem-equipamento="@ordem.Equipamento"
                                                        data-ordem-modelo="@ordem.Modelo"
                                                        data-ordem-descricao="@ordem.DescricaoProblema"
                                                        data-ordem-diagnostico="@ordem.DiagnosticoTecnico"
                                                        data-ordem-solucao="@ordem.SolucaoAplicada"
                                                        data-ordem-abertura="@ordem.DataAbertura.ToString("dd/MM/yyyy HH:mm")"
                                                        data-ordem-abertura-input="@ordem.DataAbertura.ToString("yyyy-MM-ddTHH:mm")"
                                                        data-ordem-previsao="@(ordem.DataPrevisao?.ToString("dd/MM/yyyy HH:mm"))"
                                                        data-ordem-previsao-input="@(ordem.DataPrevisao?.ToString("yyyy-MM-ddTHH:mm"))"
                                                        data-ordem-conclusao="@(ordem.DataConclusao?.ToString("dd/MM/yyyy HH:mm"))"
                                                        data-ordem-conclusao-input="@(ordem.DataConclusao?.ToString("yyyy-MM-ddTHH:mm"))"
                                                        data-ordem-status="@ordem.Status"
                                                        data-ordem-prioridade="@ordem.Prioridade"
                                                        data-ordem-servico-ids="@string.Join(",", ordem.Servicos.Select(item => item.ServicoId))"
                                                        data-ordem-servicos="@string.Join(" • ", ordem.Servicos.OrderBy(item => item.Servico.Descricao).Select(item => $"{item.Servico.Descricao} — {item.Valor:C}"))"
                                                        data-ordem-observacoes="@ordem.Observacoes"
                                                        data-ordem-valor-servico="@ordem.ValorServico.ToString("N2")"
                                                        data-ordem-valor-servico-input="@ordem.ValorServico.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                                        data-ordem-valor-pecas="@ordem.ValorPecas.ToString("N2")"
                                                        data-ordem-valor-pecas-input="@ordem.ValorPecas.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)">
                                                    Ver ordem
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }

                        <tr id="ordensSemResultado" class="d-none">
                            <td colspan="7" class="ordens-empty-state">
                                <strong>Nenhuma ordem encontrada</strong>
                                <span>Tente ajustar a pesquisa ou os filtros selecionados.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

<div class="modal fade" id="modalCadastroOrdem" tabindex="-1" aria-labelledby="tituloModalCadastroOrdem" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <form asp-controller="OrdensServico"
                  asp-action="Cadastrar"
                  method="post"
                  class="ordem-modal-form">
                <div class="modal-header">
                    <div>
                        <span class="ordem-modal-eyebrow">Nova ordem de serviço</span>
                        <h2 class="modal-title fs-5" id="tituloModalCadastroOrdem">Dados da ordem</h2>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>

                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="ordem-form-section">
                        <h3>Identificação</h3>
                        <div class="row g-3">
                            <div class="col-md-7">
                                <label asp-for="Cadastro.ClienteId" class="form-label"></label>
                                <select asp-for="Cadastro.ClienteId" class="form-select">
                                    <option value="">Selecione um cliente</option>
                                    @foreach (var cliente in Model.Clientes)
                                    {
                                        <option value="@cliente.Id">@cliente.Nome</option>
                                    }
                                </select>
                                <span asp-validation-for="Cadastro.ClienteId" class="text-danger"></span>
                            </div>
                            <div class="col-md-5">
                                <label asp-for="Cadastro.ResponsavelId" class="form-label"></label>
                                <input asp-for="Cadastro.ResponsavelId" class="form-control" min="1" placeholder="Opcional" />
                                <span asp-validation-for="Cadastro.ResponsavelId" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Cadastro.Equipamento" class="form-label"></label>
                                <input asp-for="Cadastro.Equipamento" class="form-control" />
                                <span asp-validation-for="Cadastro.Equipamento" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Cadastro.Modelo" class="form-label"></label>
                                <input asp-for="Cadastro.Modelo" class="form-control" />
                                <span asp-validation-for="Cadastro.Modelo" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="ordem-form-section">
                        <h3>Atendimento técnico</h3>
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Cadastro.DescricaoProblema" class="form-label"></label>
                                <textarea asp-for="Cadastro.DescricaoProblema" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Cadastro.DescricaoProblema" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Cadastro.DiagnosticoTecnico" class="form-label"></label>
                                <textarea asp-for="Cadastro.DiagnosticoTecnico" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Cadastro.DiagnosticoTecnico" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Cadastro.SolucaoAplicada" class="form-label"></label>
                                <textarea asp-for="Cadastro.SolucaoAplicada" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Cadastro.SolucaoAplicada" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="ordem-form-section">
                        <h3>Serviços</h3>
                        @if (Model.ServicosDisponiveis.Count == 0)
                        {
                            <div class="ordem-services-empty">
                                Nenhum serviço cadastrado.
                                <a asp-controller="Servicos" asp-action="Index">Cadastrar serviço</a>
                            </div>
                        }
                        else
                        {
                            <div class="dropdown ordem-services-dropdown">
                                <button type="button"
                                        id="seletorServicosCadastro"
                                        class="form-select text-start ordem-services-toggle"
                                        data-bs-toggle="dropdown"
                                        data-bs-auto-close="outside"
                                        data-bs-boundary="viewport"
                                        aria-expanded="false">
                                    <span id="resumoServicosCadastro">Selecione os serviços</span>
                                </button>
                                <div class="dropdown-menu ordem-services-menu" aria-labelledby="seletorServicosCadastro">
                                    <div class="ordem-services-menu-header">Selecione um ou mais serviços</div>
                                    <div class="ordem-services-search">
                                        <label class="visually-hidden" for="pesquisaServicosCadastro">Pesquisar serviços</label>
                                        <input type="search"
                                               id="pesquisaServicosCadastro"
                                               class="form-control"
                                               placeholder="Pesquisar serviço"
                                               autocomplete="off" />
                                    </div>
                                    <div class="ordem-services-list">
                                        @foreach (var servico in Model.ServicosDisponiveis)
                                        {
                                            <label class="ordem-service-option" for="cadastroServico_@servico.Id">
                                                <input type="checkbox"
                                                       id="cadastroServico_@servico.Id"
                                                       name="Cadastro.ServicoIds"
                                                       value="@servico.Id"
                                                       data-descricao="@servico.Descricao"
                                                       data-valor="@servico.Valor.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                                       class="form-check-input js-servico-cadastro"
                                                       checked="@(Model.Cadastro.ServicoIds.Contains(servico.Id))" />
                                                <span>
                                                    <strong>@servico.Descricao</strong>
                                                    <small>@servico.TempoEstimadoHoras.ToString("0.##") h · @servico.Valor.ToString("C")</small>
                                                </span>
                                            </label>
                                        }
                                        <div id="nenhumServicoCadastro" class="ordem-services-no-results d-none">
                                            Nenhum serviço encontrado.
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="ordem-selected-services" aria-live="polite">
                                <table class="table mb-0">
                                    <thead>
                                        <tr>
                                            <th scope="col">Serviço</th>
                                            <th scope="col" class="text-end">Valor</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tabelaServicosCadastro"></tbody>
                                    <tfoot>
                                        <tr>
                                            <th scope="row">Total</th>
                                            <td id="totalServicosCadastro" class="text-end">R$ 0,00</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        }
                        <span asp-validation-for="Cadastro.ServicoIds" class="text-danger"></span>
                    </div>

                    <div class="ordem-form-section">
                        <h3>Prazo e situação</h3>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="Cadastro.DataAbertura" class="form-label"></label>
                                <input asp-for="Cadastro.DataAbertura" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="form-control" />
                                <span asp-validation-for="Cadastro.DataAbertura" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Cadastro.DataPrevisao" class="form-label"></label>
                                <input asp-for="Cadastro.DataPrevisao" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="form-control" />
                                <span asp-validation-for="Cadastro.DataPrevisao" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Cadastro.DataConclusao" class="form-label"></label>
                                <input asp-for="Cadastro.DataConclusao" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="form-control" />
                                <span asp-validation-for="Cadastro.DataConclusao" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Cadastro.Status" class="form-label"></label>
                                <select asp-for="Cadastro.Status" class="form-select">
                                    <option value="Aberta">Aberta</option>
                                    <option value="Em andamento">Em andamento</option>
                                    <option value="Aguardando peças">Aguardando peças</option>
                                    <option value="Concluída">Concluída</option>
                                    <option value="Cancelada">Cancelada</option>
                                </select>
                                <span asp-validation-for="Cadastro.Status" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Cadastro.Prioridade" class="form-label"></label>
                                <select asp-for="Cadastro.Prioridade" class="form-select">
                                    <option value="Baixa">Baixa</option>
                                    <option value="Normal">Normal</option>
                                    <option value="Alta">Alta</option>
                                    <option value="Urgente">Urgente</option>
                                </select>
                                <span asp-validation-for="Cadastro.Prioridade" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="ordem-form-section mb-0">
                        <h3>Valores e observações</h3>
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label asp-for="Cadastro.ValorServico" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text">R$</span>
                                    <input asp-for="Cadastro.ValorServico"
                                           asp-format="{0:N2}"
                                           type="text"
                                           class="form-control"
                                           readonly
                                           aria-label="Valor total dos serviços selecionados" />
                                </div>
                                <span asp-validation-for="Cadastro.ValorServico" class="text-danger"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Cadastro.ValorPecas" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text">R$</span>
                                    <input asp-for="Cadastro.ValorPecas"
                                           asp-format="{0:N2}"
                                           type="text"
                                           inputmode="decimal"
                                           class="form-control ordem-currency-input"
                                           autocomplete="off" />
                                </div>
                                <span asp-validation-for="Cadastro.ValorPecas" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Cadastro.Observacoes" class="form-label"></label>
                                <textarea asp-for="Cadastro.Observacoes" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Cadastro.Observacoes" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Cadastrar ordem</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modalOrdem" tabindex="-1" aria-labelledby="tituloModalOrdem" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <span class="ordem-modal-eyebrow" id="numeroModalOrdem"></span>
                    <h2 class="modal-title fs-5" id="tituloModalOrdem">Detalhes da ordem</h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <div class="ordem-details-grid" id="modoVisualizacaoOrdem">
                    <div class="ordem-detail"><span>Cliente</span><strong id="detalheCliente"></strong></div>
                    <div class="ordem-detail"><span>ID do cliente</span><strong id="detalheClienteId"></strong></div>
                    <div class="ordem-detail"><span>ID do responsável</span><strong id="detalheResponsavelId"></strong></div>
                    <div class="ordem-detail"><span>Equipamento</span><strong id="detalheEquipamento"></strong></div>
                    <div class="ordem-detail"><span>Modelo</span><strong id="detalheModelo"></strong></div>
                    <div class="ordem-detail"><span>Data de abertura</span><strong id="detalheAbertura"></strong></div>
                    <div class="ordem-detail"><span>Data de previsão</span><strong id="detalhePrevisao"></strong></div>
                    <div class="ordem-detail"><span>Data de conclusão</span><strong id="detalheConclusao"></strong></div>
                    <div class="ordem-detail"><span>Status</span><strong id="detalheStatus"></strong></div>
                    <div class="ordem-detail"><span>Prioridade</span><strong id="detalhePrioridade"></strong></div>
                    <div class="ordem-detail"><span>Valor do serviço</span><strong id="detalheValorServico"></strong></div>
                    <div class="ordem-detail"><span>Valor de peças</span><strong id="detalheValorPecas"></strong></div>
                    <div class="ordem-detail ordem-detail-wide"><span>Serviços selecionados</span><p id="detalheServicos"></p></div>
                    <div class="ordem-detail ordem-detail-wide"><span>Descrição do problema</span><p id="detalheDescricao"></p></div>
                    <div class="ordem-detail ordem-detail-wide"><span>Diagnóstico técnico</span><p id="detalheDiagnostico"></p></div>
                    <div class="ordem-detail ordem-detail-wide"><span>Solução aplicada</span><p id="detalheSolucao"></p></div>
                    <div class="ordem-detail ordem-detail-wide"><span>Observações</span><p id="detalheObservacoes"></p></div>
                </div>

                <form asp-controller="OrdensServico" asp-action="Editar" method="post" id="formEdicaoOrdem" class="ordem-modal-form d-none">
                    <input asp-for="Edicao.Id" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="ordem-form-section">
                        <h3>Identificação</h3>
                        <div class="row g-3">
                            <div class="col-md-7">
                                <label asp-for="Edicao.ClienteId" class="form-label"></label>
                                <select asp-for="Edicao.ClienteId" class="form-select">
                                    <option value="">Selecione um cliente</option>
                                    @foreach (var cliente in Model.Clientes)
                                    {
                                        <option value="@cliente.Id">@cliente.Nome</option>
                                    }
                                </select>
                                <span asp-validation-for="Edicao.ClienteId" class="text-danger"></span>
                            </div>
                            <div class="col-md-5">
                                <label asp-for="Edicao.ResponsavelId" class="form-label"></label>
                                <input asp-for="Edicao.ResponsavelId" class="form-control" min="1" placeholder="Opcional" />
                                <span asp-validation-for="Edicao.ResponsavelId" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Edicao.Equipamento" class="form-label"></label>
                                <input asp-for="Edicao.Equipamento" class="form-control" />
                                <span asp-validation-for="Edicao.Equipamento" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Edicao.Modelo" class="form-label"></label>
                                <input asp-for="Edicao.Modelo" class="form-control" />
                                <span asp-validation-for="Edicao.Modelo" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="ordem-form-section">
                        <h3>Atendimento técnico</h3>
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Edicao.DescricaoProblema" class="form-label"></label>
                                <textarea asp-for="Edicao.DescricaoProblema" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Edicao.DescricaoProblema" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Edicao.DiagnosticoTecnico" class="form-label"></label>
                                <textarea asp-for="Edicao.DiagnosticoTecnico" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Edicao.DiagnosticoTecnico" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Edicao.SolucaoAplicada" class="form-label"></label>
                                <textarea asp-for="Edicao.SolucaoAplicada" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Edicao.SolucaoAplicada" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="ordem-form-section">
                        <h3>Serviços</h3>
                        @if (Model.ServicosDisponiveis.Count == 0)
                        {
                            <div class="ordem-services-empty">
                                Nenhum serviço cadastrado.
                                <a asp-controller="Servicos" asp-action="Index">Cadastrar serviço</a>
                            </div>
                        }
                        else
                        {
                            <div class="dropdown ordem-services-dropdown">
                                <button type="button"
                                        id="seletorServicosEdicao"
                                        class="form-select text-start ordem-services-toggle"
                                        data-bs-toggle="dropdown"
                                        data-bs-auto-close="outside"
                                        data-bs-boundary="viewport"
                                        aria-expanded="false">
                                    <span id="resumoServicosEdicao">Selecione os serviços</span>
                                </button>
                                <div class="dropdown-menu ordem-services-menu" aria-labelledby="seletorServicosEdicao">
                                    <div class="ordem-services-menu-header">Selecione um ou mais serviços</div>
                                    <div class="ordem-services-search">
                                        <label class="visually-hidden" for="pesquisaServicosEdicao">Pesquisar serviços</label>
                                        <input type="search"
                                               id="pesquisaServicosEdicao"
                                               class="form-control"
                                               placeholder="Pesquisar serviço"
                                               autocomplete="off" />
                                    </div>
                                    <div class="ordem-services-list">
                                        @foreach (var servico in Model.ServicosDisponiveis)
                                        {
                                            <label class="ordem-service-option" for="edicaoServico_@servico.Id">
                                                <input type="checkbox"
                                                       id="edicaoServico_@servico.Id"
                                                       name="Edicao.ServicoIds"
                                                       value="@servico.Id"
                                                       data-descricao="@servico.Descricao"
                                                       data-valor="@servico.Valor.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                                       class="form-check-input js-servico-edicao"
                                                       checked="@(Model.Edicao.ServicoIds.Contains(servico.Id))" />
                                                <span>
                                                    <strong>@servico.Descricao</strong>
                                                    <small>@servico.TempoEstimadoHoras.ToString("0.##") h · @servico.Valor.ToString("C")</small>
                                                </span>
                                            </label>
                                        }
                                        <div id="nenhumServicoEdicao" class="ordem-services-no-results d-none">
                                            Nenhum serviço encontrado.
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="ordem-selected-services" aria-live="polite">
                                <table class="table mb-0">
                                    <thead>
                                        <tr>
                                            <th scope="col">Serviço</th>
                                            <th scope="col" class="text-end">Valor</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tabelaServicosEdicao"></tbody>
                                    <tfoot>
                                        <tr>
                                            <th scope="row">Total</th>
                                            <td id="totalServicosEdicao" class="text-end">R$ 0,00</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        }
                        <span asp-validation-for="Edicao.ServicoIds" class="text-danger"></span>
                    </div>

                    <div class="ordem-form-section">
                        <h3>Prazo e situação</h3>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="Edicao.DataAbertura" class="form-label"></label>
                                <input asp-for="Edicao.DataAbertura" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="form-control" />
                                <span asp-validation-for="Edicao.DataAbertura" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Edicao.DataPrevisao" class="form-label"></label>
                                <input asp-for="Edicao.DataPrevisao" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="form-control" />
                                <span asp-validation-for="Edicao.DataPrevisao" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Edicao.DataConclusao" class="form-label"></label>
                                <input asp-for="Edicao.DataConclusao" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="form-control" />
                                <span asp-validation-for="Edicao.DataConclusao" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Edicao.Status" class="form-label"></label>
                                <select asp-for="Edicao.Status" class="form-select">
                                    <option value="Aberta">Aberta</option>
                                    <option value="Em andamento">Em andamento</option>
                                    <option value="Aguardando peças">Aguardando peças</option>
                                    <option value="Concluída">Concluída</option>
                                    <option value="Cancelada">Cancelada</option>
                                </select>
                                <span asp-validation-for="Edicao.Status" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Edicao.Prioridade" class="form-label"></label>
                                <select asp-for="Edicao.Prioridade" class="form-select">
                                    <option value="Baixa">Baixa</option>
                                    <option value="Normal">Normal</option>
                                    <option value="Alta">Alta</option>
                                    <option value="Urgente">Urgente</option>
                                </select>
                                <span asp-validation-for="Edicao.Prioridade" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="ordem-form-section mb-0">
                        <h3>Valores e observações</h3>
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label asp-for="Edicao.ValorServico" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text">R$</span>
                                    <input asp-for="Edicao.ValorServico" asp-format="{0:N2}" type="text" class="form-control" readonly aria-label="Valor total dos serviços selecionados" />
                                </div>
                                <span asp-validation-for="Edicao.ValorServico" class="text-danger"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Edicao.ValorPecas" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text">R$</span>
                                    <input asp-for="Edicao.ValorPecas" asp-format="{0:N2}" type="text" inputmode="decimal" class="form-control ordem-currency-input" autocomplete="off" />
                                </div>
                                <span asp-validation-for="Edicao.ValorPecas" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Edicao.Observacoes" class="form-label"></label>
                                <textarea asp-for="Edicao.Observacoes" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Edicao.Observacoes" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer ordem-modal-actions">
                <form asp-controller="OrdensServico" asp-action="Finalizar" method="post" id="formFinalizarOrdem" class="me-auto">
                    <input type="hidden" name="id" id="finalizarOrdemId" />
                    <button type="submit" class="btn btn-success" id="botaoFinalizarOrdem">Finalizar</button>
                </form>
                <a class="btn btn-outline-secondary" id="botaoImprimirOrdem" target="_blank" rel="noopener">Imprimir</a>
                <button type="button" class="btn btn-primary" id="botaoEditarOrdem">Editar</button>
                <button type="button" class="btn btn-outline-secondary d-none" id="botaoCancelarEdicao">Cancelar edição</button>
                <button type="submit" class="btn btn-primary d-none" id="botaoSalvarEdicao" form="formEdicaoOrdem">Salvar alterações</button>
                <button type="button" class="btn btn-outline-secondary" id="botaoFecharOrdem" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const campoPesquisa = document.getElementById('pesquisaOrdens');
            const filtroStatus = document.getElementById('filtroStatusOrdens');
            const filtroPrioridade = document.getElementById('filtroPrioridadeOrdens');
            const botaoLimparFiltros = document.getElementById('limparFiltrosOrdens');
            const contadorOrdens = document.getElementById('contadorOrdens');
            const linhasOrdens = Array.from(document.querySelectorAll('.ordens-row'));
            const estadoSemResultado = document.getElementById('ordensSemResultado');

            function normalizarTexto(valor) {
                return String(valor || '')
                    .normalize('NFD')
                    .replace(/[\u0300-\u036f]/g, '')
                    .toLocaleLowerCase('pt-BR')
                    .trim();
            }

            function atualizarListagem() {
                if (!campoPesquisa || !filtroStatus || !filtroPrioridade) return;

                const pesquisa = normalizarTexto(campoPesquisa.value);
                const status = normalizarTexto(filtroStatus.value);
                const prioridade = normalizarTexto(filtroPrioridade.value);
                let quantidadeVisivel = 0;

                linhasOrdens.forEach(function (linha) {
                    const correspondePesquisa = normalizarTexto(linha.dataset.pesquisa).includes(pesquisa);
                    const correspondeStatus = !status || normalizarTexto(linha.dataset.status) === status;
                    const correspondePrioridade = !prioridade || normalizarTexto(linha.dataset.prioridade) === prioridade;
                    const deveExibir = correspondePesquisa && correspondeStatus && correspondePrioridade;

                    linha.classList.toggle('d-none', !deveExibir);
                    if (deveExibir) quantidadeVisivel++;
                });

                const possuiFiltros = Boolean(pesquisa || status || prioridade);
                contadorOrdens.textContent = quantidadeVisivel === 1
                    ? '1 ordem encontrada'
                    : `${quantidadeVisivel} ordens encontradas`;
                estadoSemResultado?.classList.toggle('d-none', quantidadeVisivel > 0);
                botaoLimparFiltros?.classList.toggle('d-none', !possuiFiltros);
            }

            campoPesquisa?.addEventListener('input', atualizarListagem);
            filtroStatus?.addEventListener('change', atualizarListagem);
            filtroPrioridade?.addEventListener('change', atualizarListagem);
            botaoLimparFiltros?.addEventListener('click', function () {
                campoPesquisa.value = '';
                filtroStatus.value = '';
                filtroPrioridade.value = '';
                atualizarListagem();
                campoPesquisa.focus();
            });

            function converterDecimalBrasileiro(valor) {
                const texto = String(valor ?? '').trim().replace(/\s/g, '');
                if (!texto) return Number.NaN;

                const normalizado = texto.includes(',')
                    ? texto.replace(/\./g, '').replace(',', '.')
                    : texto;

                return Number(normalizado);
            }

            if (window.jQuery && window.jQuery.validator) {
                window.jQuery.validator.methods.number = function (value, element) {
                    return this.optional(element) || Number.isFinite(converterDecimalBrasileiro(value));
                };

                window.jQuery.validator.methods.range = function (value, element, params) {
                    if (this.optional(element)) return true;

                    const numero = converterDecimalBrasileiro(value);
                    const minimo = converterDecimalBrasileiro(params[0]);
                    const maximo = converterDecimalBrasileiro(params[1]);
                    return Number.isFinite(numero) && numero >= minimo && numero <= maximo;
                };
            }

            document.querySelectorAll('.ordem-currency-input').forEach(function (campo) {
                campo.addEventListener('blur', function () {
                    const numero = converterDecimalBrasileiro(campo.value);
                    if (Number.isFinite(numero)) {
                        campo.value = numero.toLocaleString('pt-BR', {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        });
                    }
                });
            });

            function formatarMoeda(valor) {
                return Number(valor || 0).toLocaleString('pt-BR', {
                    style: 'currency',
                    currency: 'BRL'
                });
            }

            function renderizarTabelaServicos(contexto, selecionados, total) {
                const sufixo = contexto === 'cadastro' ? 'Cadastro' : 'Edicao';
                const corpoTabela = document.getElementById(`tabelaServicos${sufixo}`);
                const totalTabela = document.getElementById(`totalServicos${sufixo}`);
                if (!corpoTabela || !totalTabela) return;

                corpoTabela.replaceChildren();

                if (selecionados.length === 0) {
                    const linhaVazia = document.createElement('tr');
                    const celulaVazia = document.createElement('td');
                    celulaVazia.colSpan = 2;
                    celulaVazia.className = 'ordem-selected-services-empty';
                    celulaVazia.textContent = 'Nenhum serviço selecionado.';
                    linhaVazia.appendChild(celulaVazia);
                    corpoTabela.appendChild(linhaVazia);
                } else {
                    selecionados.forEach(function (checkbox) {
                        const linha = document.createElement('tr');
                        const descricao = document.createElement('td');
                        const valor = document.createElement('td');

                        descricao.textContent = checkbox.dataset.descricao;
                        valor.className = 'text-end';
                        valor.textContent = formatarMoeda(checkbox.dataset.valor);
                        linha.append(descricao, valor);
                        corpoTabela.appendChild(linha);
                    });
                }

                totalTabela.textContent = formatarMoeda(total);
            }

            function filtrarServicos(contexto) {
                const sufixo = contexto === 'cadastro' ? 'Cadastro' : 'Edicao';
                const campoPesquisa = document.getElementById(`pesquisaServicos${sufixo}`);
                const estadoSemResultado = document.getElementById(`nenhumServico${sufixo}`);
                if (!campoPesquisa || !estadoSemResultado) return;

                const pesquisa = normalizarTexto(campoPesquisa.value);
                let quantidadeVisivel = 0;

                document.querySelectorAll(`.js-servico-${contexto}`).forEach(function (checkbox) {
                    const opcao = checkbox.closest('.ordem-service-option');
                    const deveExibir = normalizarTexto(checkbox.dataset.descricao).includes(pesquisa);
                    opcao.classList.toggle('d-none', !deveExibir);
                    if (deveExibir) quantidadeVisivel++;
                });

                estadoSemResultado.classList.toggle('d-none', quantidadeVisivel > 0);
            }

            function configurarPesquisaServicos(contexto) {
                const sufixo = contexto === 'cadastro' ? 'Cadastro' : 'Edicao';
                const campoPesquisa = document.getElementById(`pesquisaServicos${sufixo}`);
                if (!campoPesquisa) return;

                campoPesquisa.addEventListener('input', function () {
                    filtrarServicos(contexto);
                });

                const dropdown = campoPesquisa.closest('.ordem-services-dropdown');
                dropdown.addEventListener('shown.bs.dropdown', function () {
                    campoPesquisa.focus();
                });
                dropdown.addEventListener('hidden.bs.dropdown', function () {
                    campoPesquisa.value = '';
                    filtrarServicos(contexto);
                });
            }

            function atualizarValorServicos(contexto) {
                const checkboxes = document.querySelectorAll(`.js-servico-${contexto}`);
                const selecionados = Array.from(checkboxes)
                    .filter(function (checkbox) { return checkbox.checked; });
                const total = selecionados
                    .reduce(function (soma, checkbox) {
                        return soma + Number(checkbox.dataset.valor || 0);
                    }, 0);
                const prefixo = contexto === 'cadastro' ? 'Cadastro' : 'Edicao';
                const campoValor = document.getElementById(`${prefixo}_ValorServico`);
                const sufixo = contexto === 'cadastro' ? 'Cadastro' : 'Edicao';
                const resumo = document.getElementById(`resumoServicos${sufixo}`);
                const seletor = document.getElementById(`seletorServicos${sufixo}`);

                if (campoValor) {
                    campoValor.value = total.toLocaleString('pt-BR', {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });
                }

                if (resumo && seletor) {
                    if (selecionados.length === 0) {
                        resumo.textContent = 'Selecione os serviços';
                    } else if (selecionados.length === 1) {
                        resumo.textContent = selecionados[0].dataset.descricao;
                    } else {
                        resumo.textContent = `${selecionados.length} serviços selecionados`;
                    }

                    seletor.classList.toggle('has-selection', selecionados.length > 0);
                    seletor.setAttribute(
                        'aria-label',
                        selecionados.length === 0
                            ? 'Selecionar serviços'
                            : `${selecionados.length} serviços selecionados`
                    );
                }

                renderizarTabelaServicos(contexto, selecionados, total);
            }

            function selecionarServicosEdicao(ids) {
                const idsSelecionados = new Set(
                    String(ids || '').split(',').filter(Boolean)
                );

                document.querySelectorAll('.js-servico-edicao').forEach(function (checkbox) {
                    checkbox.checked = idsSelecionados.has(checkbox.value);
                });
                atualizarValorServicos('edicao');
            }

            document.querySelectorAll('.js-servico-cadastro').forEach(function (checkbox) {
                checkbox.addEventListener('change', function () {
                    atualizarValorServicos('cadastro');
                });
            });
            document.querySelectorAll('.js-servico-edicao').forEach(function (checkbox) {
                checkbox.addEventListener('change', function () {
                    atualizarValorServicos('edicao');
                });
            });
            configurarPesquisaServicos('cadastro');
            configurarPesquisaServicos('edicao');
            atualizarValorServicos('cadastro');
            atualizarValorServicos('edicao');

            const modal = document.getElementById('modalOrdem');
            const valorOuTraco = function (valor) { return valor || '—'; };

            modal.addEventListener('show.bs.modal', function (event) {
                if (!event.relatedTarget) return;
                const dados = event.relatedTarget.dataset;
                document.getElementById('numeroModalOrdem').textContent = dados.ordemNumero;
                document.getElementById('tituloModalOrdem').textContent = dados.ordemEquipamento;
                document.getElementById('detalheCliente').textContent = dados.ordemCliente;
                document.getElementById('detalheClienteId').textContent = dados.ordemClienteId;
                document.getElementById('detalheResponsavelId').textContent = valorOuTraco(dados.ordemResponsavelId);
                document.getElementById('detalheEquipamento').textContent = dados.ordemEquipamento;
                document.getElementById('detalheModelo').textContent = dados.ordemModelo;
                document.getElementById('detalheAbertura').textContent = dados.ordemAbertura;
                document.getElementById('detalhePrevisao').textContent = valorOuTraco(dados.ordemPrevisao);
                document.getElementById('detalheConclusao').textContent = valorOuTraco(dados.ordemConclusao);
                document.getElementById('detalheStatus').textContent = dados.ordemStatus;
                document.getElementById('detalhePrioridade').textContent = dados.ordemPrioridade;
                document.getElementById('detalheValorServico').textContent = 'R$ ' + dados.ordemValorServico;
                document.getElementById('detalheValorPecas').textContent = 'R$ ' + dados.ordemValorPecas;
                document.getElementById('detalheServicos').textContent = valorOuTraco(dados.ordemServicos);
                document.getElementById('detalheDescricao').textContent = dados.ordemDescricao;
                document.getElementById('detalheDiagnostico').textContent = valorOuTraco(dados.ordemDiagnostico);
                document.getElementById('detalheSolucao').textContent = valorOuTraco(dados.ordemSolucao);
                document.getElementById('detalheObservacoes').textContent = valorOuTraco(dados.ordemObservacoes);
            });

            const modoVisualizacao = document.getElementById('modoVisualizacaoOrdem');
            const formEdicao = document.getElementById('formEdicaoOrdem');
            const botaoEditar = document.getElementById('botaoEditarOrdem');
            const botaoCancelar = document.getElementById('botaoCancelarEdicao');
            const botaoSalvar = document.getElementById('botaoSalvarEdicao');
            const botaoFechar = document.getElementById('botaoFecharOrdem');
            const formFinalizar = document.getElementById('formFinalizarOrdem');
            const botaoFinalizar = document.getElementById('botaoFinalizarOrdem');
            const botaoImprimir = document.getElementById('botaoImprimirOrdem');

            function definirValor(id, valor) {
                const campo = document.getElementById(id);
                if (campo) campo.value = valor || '';
            }

            function exibirVisualizacao() {
                modoVisualizacao.classList.remove('d-none');
                formEdicao.classList.add('d-none');
                botaoEditar.classList.remove('d-none');
                botaoCancelar.classList.add('d-none');
                botaoSalvar.classList.add('d-none');
                botaoFechar.classList.remove('d-none');
                formFinalizar.classList.remove('d-none');
                botaoImprimir.classList.remove('d-none');
            }

            function exibirEdicao() {
                modoVisualizacao.classList.add('d-none');
                formEdicao.classList.remove('d-none');
                botaoEditar.classList.add('d-none');
                botaoCancelar.classList.remove('d-none');
                botaoSalvar.classList.remove('d-none');
                botaoFechar.classList.add('d-none');
                formFinalizar.classList.add('d-none');
                botaoImprimir.classList.add('d-none');
            }

            function preencherEdicao(dados) {
                definirValor('Edicao_Id', dados.ordemId);
                definirValor('Edicao_ClienteId', dados.ordemClienteId);
                definirValor('Edicao_ResponsavelId', dados.ordemResponsavelId);
                definirValor('Edicao_Equipamento', dados.ordemEquipamento);
                definirValor('Edicao_Modelo', dados.ordemModelo);
                definirValor('Edicao_DescricaoProblema', dados.ordemDescricao);
                definirValor('Edicao_DiagnosticoTecnico', dados.ordemDiagnostico);
                definirValor('Edicao_SolucaoAplicada', dados.ordemSolucao);
                definirValor('Edicao_DataAbertura', dados.ordemAberturaInput);
                definirValor('Edicao_DataPrevisao', dados.ordemPrevisaoInput);
                definirValor('Edicao_DataConclusao', dados.ordemConclusaoInput);
                definirValor('Edicao_Status', dados.ordemStatus);
                definirValor('Edicao_Prioridade', dados.ordemPrioridade);
                definirValor('Edicao_Observacoes', dados.ordemObservacoes);
                definirValor('Edicao_ValorPecas', dados.ordemValorPecasInput.replace('.', ','));
                selecionarServicosEdicao(dados.ordemServicoIds);
            }

            function preencherVisualizacao(dados) {
                document.getElementById('numeroModalOrdem').textContent = dados.ordemNumero;
                document.getElementById('tituloModalOrdem').textContent = dados.ordemEquipamento;
                document.getElementById('detalheCliente').textContent = dados.ordemCliente;
                document.getElementById('detalheClienteId').textContent = dados.ordemClienteId;
                document.getElementById('detalheResponsavelId').textContent = valorOuTraco(dados.ordemResponsavelId);
                document.getElementById('detalheEquipamento').textContent = dados.ordemEquipamento;
                document.getElementById('detalheModelo').textContent = dados.ordemModelo;
                document.getElementById('detalheAbertura').textContent = dados.ordemAbertura;
                document.getElementById('detalhePrevisao').textContent = valorOuTraco(dados.ordemPrevisao);
                document.getElementById('detalheConclusao').textContent = valorOuTraco(dados.ordemConclusao);
                document.getElementById('detalheStatus').textContent = dados.ordemStatus;
                document.getElementById('detalhePrioridade').textContent = dados.ordemPrioridade;
                document.getElementById('detalheValorServico').textContent = 'R$ ' + dados.ordemValorServico;
                document.getElementById('detalheValorPecas').textContent = 'R$ ' + dados.ordemValorPecas;
                document.getElementById('detalheServicos').textContent = valorOuTraco(dados.ordemServicos);
                document.getElementById('detalheDescricao').textContent = dados.ordemDescricao;
                document.getElementById('detalheDiagnostico').textContent = valorOuTraco(dados.ordemDiagnostico);
                document.getElementById('detalheSolucao').textContent = valorOuTraco(dados.ordemSolucao);
                document.getElementById('detalheObservacoes').textContent = valorOuTraco(dados.ordemObservacoes);
            }

            function configurarAcoes(dados) {
                document.getElementById('finalizarOrdemId').value = dados.ordemId;
                botaoImprimir.href = '@Url.Action("Imprimir", "OrdensServico")?id=' + encodeURIComponent(dados.ordemId);

                const status = (dados.ordemStatus || '')
                    .normalize('NFD')
                    .replace(/[\u0300-\u036f]/g, '')
                    .toLowerCase();
                const finalizacaoIndisponivel = status === 'concluida' || status === 'cancelada';
                botaoFinalizar.disabled = finalizacaoIndisponivel;
                botaoFinalizar.title = finalizacaoIndisponivel
                    ? 'Esta ordem já foi concluída ou cancelada.'
                    : 'Marcar esta ordem como concluída';
            }

            modal.addEventListener('show.bs.modal', function (event) {
                if (!event.relatedTarget) return;
                const dados = event.relatedTarget.dataset;
                preencherEdicao(dados);
                configurarAcoes(dados);
                exibirVisualizacao();
            });

            botaoEditar.addEventListener('click', exibirEdicao);
            botaoCancelar.addEventListener('click', exibirVisualizacao);
            formFinalizar.addEventListener('submit', function (event) {
                if (!window.confirm('Deseja finalizar esta ordem de serviço?')) {
                    event.preventDefault();
                }
            });

            @if (Model.AbrirModalEdicao)
            {
                <text>
                    const ordemComErro = document.querySelector('.js-ver-ordem[data-ordem-id="@Model.Edicao.Id"]');
                    if (ordemComErro) {
                        preencherVisualizacao(ordemComErro.dataset);
                        configurarAcoes(ordemComErro.dataset);
                    }
                    selecionarServicosEdicao('@string.Join(",", Model.Edicao.ServicoIds)');
                    exibirEdicao();
                    bootstrap.Modal.getOrCreateInstance(modal).show();
                </text>
            }
        });
    </script>

    @if (Model.AbrirModalCadastro)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                bootstrap.Modal.getOrCreateInstance(document.getElementById('modalCadastroOrdem')).show();
            });
        </script>
    }
}
